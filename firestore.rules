rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The one account allowed to act as admin. Defined ONCE here and
    // referenced everywhere below — edit this single line, never paste
    // the UID anywhere else in this file, to avoid it drifting out of
    // sync between rules.
    function isAdmin() {
      return request.auth != null && request.auth.uid == "tyZm71U2oSavyB93G5cTw7OsLi82";
    }

    // A listing needs at least one way to reach the poster — either an
    // email or a postal address/P.O. Box. Neither is required on its own.
    function hasContactMethod(data) {
      return (data.contactEmail is string && data.contactEmail.size() > 0)
        || (data.contactAddress is string && data.contactAddress.size() > 0);
    }

    match /jobListings/{listingId} {
      // Public can only ever read approved listings — pending/rejected
      // ones are invisible to them until reviewed. The admin account can
      // read listings in any status, since they need to review pending
      // (and see rejected/approved) ones.
      allow read: if resource.data.status == "approved" || isAdmin();

      // Public can submit a new listing, but only as "pending" — nobody
      // can create a doc that's already approved. Basic shape/length
      // validation happens here too, as a second layer behind the form's
      // own client-side checks.
      allow create: if request.resource.data.status == "pending"
        && request.resource.data.companyName is string
        && request.resource.data.companyName.size() > 0
        && request.resource.data.companyName.size() < 200
        && request.resource.data.contactEmail is string
        && request.resource.data.contactEmail.size() < 200
        && request.resource.data.contactAddress is string
        && request.resource.data.contactAddress.size() < 300
        && hasContactMethod(request.resource.data)
        && request.resource.data.notifyByEmail is bool
        && request.resource.data.jobTitle is string
        && request.resource.data.jobTitle.size() > 0
        && request.resource.data.jobTitle.size() < 200
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() < 8000
        && request.resource.data.createdAt == request.time
        && request.resource.data.closingDate is timestamp
        && request.resource.data.closingDate > request.time;

      // Admin can make two kinds of update:
      //  1. A pure status change (approve/reject/undo) — nothing else changes.
      //  2. A content edit — fixing a typo, extending or shortening the
      //     closing date, etc. Same shape validation as a new submission,
      //     just gated to admin instead of public.
      allow update: if isAdmin() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
          && request.resource.data.status in ["pending", "approved", "rejected"])
        ||
        (request.resource.data.companyName is string
          && request.resource.data.companyName.size() > 0
          && request.resource.data.companyName.size() < 200
          && request.resource.data.contactEmail is string
          && request.resource.data.contactEmail.size() < 200
          && request.resource.data.contactAddress is string
          && request.resource.data.contactAddress.size() < 300
          && hasContactMethod(request.resource.data)
          && request.resource.data.jobTitle is string
          && request.resource.data.jobTitle.size() > 0
          && request.resource.data.jobTitle.size() < 200
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.description.size() < 8000
          && request.resource.data.closingDate is timestamp)
      );

      // Only the admin account can delete a listing.
      allow delete: if isAdmin();
    }
  }
}
